{
  "expo": {
    "name": "Dulcería Angelitos",
    "slug": "AppRepartidor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apprepartidor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.gelaciohb2004.apprepartidor",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF136",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF136",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0038FF",
          "defaultChannel": "pedidos"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que Dulcería Angelitos use la cámara para registrar la evidencia de entrega.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Dulcería Angelitos registre tu ubicación al confirmar una entrega."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec9afb8c-04f9-4c71-8afc-14e23a8e65d8"
      }
    },
    "owner": "dulceria-angelitos"
  }
}
